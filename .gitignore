data/

# ---- Python ----
__pycache__/
*.pyc
.venv/

# ---- Flutter / Dart ----
app/.dart_tool/
app/build/
app/.flutter-plugins*
app/windows/flutter/ephemeral/

# ---- misc ----
*.log
Thumbs.db
